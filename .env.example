# Copier ce fichier en .env puis remplacer les valeurs "change-me".
# Raccourci : `python scripts/init-env.py` génère un .env avec des mots de passe aléatoires.
# Les tokens API ERPNext / Moodle ne sont PAS ici : ils sont générés au démarrage
# par les jobs de bootstrap et stockés dans le volume Docker `integration-secrets`.

COMPOSE_PROJECT_NAME=opentraining

# --- ERPNext (Frappe) ---
ERPNEXT_DB_ROOT_PASSWORD=change-me
ERPNEXT_ADMIN_PASSWORD=change-me
ERPNEXT_COMPANY_NAME=OpenTraining
ERPNEXT_COMPANY_ABBR=OT
ERPNEXT_PORT=8080

# --- Moodle ---
MOODLE_DB_PASSWORD=change-me
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=change-me
MOODLE_ADMIN_EMAIL=admin@opentraining.local
MOODLE_PORT=8081

# --- PostgreSQL d'intégration ---
INTEGRATION_DB_NAME=integration
INTEGRATION_DB_USER=integration
INTEGRATION_DB_PASSWORD=change-me
INTEGRATION_DB_PORT=5433

# --- RabbitMQ ---
RABBITMQ_USER=opentraining
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Mailpit ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Integration Hub ---
API_PORT=8000
HTTP_TIMEOUT_SECONDS=5
